{
    "name": "omnibus/mondial-relay",
    "type": "library",
    "description": "Omnibus Mondial Relay carrier: relay points and tracking (API1, Web_Services.asmx, no ext-soap needed), labels (API2, the dual carrier shipment API).",
    "keywords": [
        "shipping",
        "omnibus",
        "mondial relay",
        "point relais",
        "inpost"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Marco Meyer",
            "email": "marco.meyer@glitchr.io"
        }
    ],
    "require": {
        "php": ">=8.2",
        "ext-simplexml": "*",
        "omnisense/contracts": "^1.0",
        "omnisense/omnibus": "^2.0",
        "symfony/http-client": "^6.4|^7.0|^8.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "Omnibus\\MondialRelay\\": ""
        },
        "exclude-from-classmap": [
            "/Tests/"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Omnibus\\MondialRelay\\Tests\\": "Tests/"
        }
    },
    "extra": {
        "omnisense": {
            "policy": "policy.json"
        },
        "branch-alias": {
            "dev-2.x": "2.x-dev"
        }
    },
    "config": {
        "sort-packages": true
    }
}
