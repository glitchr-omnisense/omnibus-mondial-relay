parameters:
	ignoreErrors:
		-
			message: '#^Property Omnibus\\Request\\GetSlip\:\:\$format \(string\) in isset\(\) is not nullable\.$#'
			identifier: isset.property
			count: 1
			path: Action/GetSlipAction.php

		-
			message: '#^Cannot cast mixed to string\.$#'
			identifier: cast.string
			count: 2
			path: Action/ShippingAction.php

		-
			message: '#^Method Omnibus\\MondialRelay\\Action\\ShippingAction\:\:relay\(\) return type has no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
			count: 1
			path: Action/ShippingAction.php

		-
			message: '#^Parameter \#2 \$params of method Omnibus\\MondialRelay\\Api\:\:call\(\) expects array\<string, bool\|float\|int\|string\|null\>, array\<string, mixed\> given\.$#'
			identifier: argument.type
			count: 1
			path: Action/ShippingAction.php

		-
			message: '#^Cannot access property \$STAT on mixed\.$#'
			identifier: property.nonObject
			count: 1
			path: Api.php

		-
			message: '#^Cannot call method count\(\) on mixed\.$#'
			identifier: method.nonObject
			count: 1
			path: Api.php

		-
			message: '#^Cannot cast mixed to string\.$#'
			identifier: cast.string
			count: 1
			path: Api.php

		-
			message: '#^Method Omnibus\\MondialRelay\\Api\:\:call\(\) should return SimpleXMLElement but returns mixed\.$#'
			identifier: return.type
			count: 1
			path: Api.php

		-
			message: '#^Method Omnibus\\MondialRelay\\Api\:\:phone\(\) should return string but returns string\|null\.$#'
			identifier: return.type
			count: 1
			path: Api.php

		-
			message: '#^Method Omnibus\\MondialRelay\\Api\:\:secrets\(\) should return list\<string\> but returns non\-empty\-array\<int\<0, max\>\|string, string\>\.$#'
			identifier: return.type
			count: 1
			path: Api.php

		-
			message: '#^Parameter \#1 \$string of function substr expects string, string\|null given\.$#'
			identifier: argument.type
			count: 1
			path: Api.php

		-
			message: '#^Cannot cast mixed to string\.$#'
			identifier: cast.string
			count: 4
			path: MondialRelayGatewayFactory.php

		-
			message: '#^Argument of an invalid type mixed supplied for foreach, only iterables are supported\.$#'
			identifier: foreach.nonIterable
			count: 1
			path: Tests/MondialRelayGatewayTest.php

		-
			message: '#^Cannot access offset 0 on mixed\.$#'
			identifier: offsetAccess.nonOffsetAccessible
			count: 1
			path: Tests/MondialRelayGatewayTest.php

		-
			message: '#^Cannot access property \$at on Omnibus\\Model\\TrackingEvent\|null\.$#'
			identifier: property.nonObject
			count: 2
			path: Tests/MondialRelayGatewayTest.php

		-
			message: '#^Cannot call method children\(\) on SimpleXMLElement\|false\.$#'
			identifier: method.nonObject
			count: 1
			path: Tests/MondialRelayGatewayTest.php

		-
			message: '#^Cannot call method children\(\) on mixed\.$#'
			identifier: method.nonObject
			count: 1
			path: Tests/MondialRelayGatewayTest.php

		-
			message: '#^Cannot cast mixed to string\.$#'
			identifier: cast.string
			count: 1
			path: Tests/MondialRelayGatewayTest.php

		-
			message: '#^Method Omnibus\\MondialRelay\\Tests\\MondialRelayGatewayTest\:\:params\(\) should return array\<string, string\> but returns array\<string\>\.$#'
			identifier: return.type
			count: 1
			path: Tests/MondialRelayGatewayTest.php

		-
			message: '#^Parameter \#1 \$string of function substr expects string, mixed given\.$#'
			identifier: argument.type
			count: 1
			path: Tests/MondialRelayGatewayTest.php

		-
			message: '#^Possibly invalid array key type mixed\.$#'
			identifier: offsetAccess.invalidOffset
			count: 1
			path: Tests/MondialRelayGatewayTest.php

		-
			message: '#^Property Omnibus\\MondialRelay\\Tests\\MondialRelayGatewayTest\:\:\$sent \(list\<array\{method\: string, headers\: array, body\: string\}\>\) does not accept non\-empty\-list\<array\{method\: string, headers\: mixed, body\: mixed\}\>\.$#'
			identifier: assign.propertyType
			count: 1
			path: Tests/MondialRelayGatewayTest.php

		-
			message: '#^Property Omnibus\\MondialRelay\\Tests\\MondialRelayGatewayTest\:\:\$sent type has no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
			count: 1
			path: Tests/MondialRelayGatewayTest.php
