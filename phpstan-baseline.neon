parameters:
	ignoreErrors:
		-
			message: '#^Property Omnibus\\Request\\GetSlip\:\:\$format \(string\) in isset\(\) is not nullable\.$#'
			identifier: isset.property
			count: 1
			path: Action/GetSlipAction.php

		-
			message: '#^Cannot access property \$STAT on mixed\.$#'
			identifier: property.nonObject
			count: 1
			path: Api.php

		-
			message: '#^Cannot call method count\(\) on mixed\.$#'
			identifier: method.nonObject
			count: 1
			path: Api.php

		-
			message: '#^Cannot cast mixed to string\.$#'
			identifier: cast.string
			count: 1
			path: Api.php

		-
			message: '#^Method Omnibus\\MondialRelay\\Api\:\:call\(\) should return SimpleXMLElement but returns mixed\.$#'
			identifier: return.type
			count: 1
			path: Api.php

		-
			message: '#^Method Omnibus\\MondialRelay\\Api\:\:phone\(\) should return string but returns string\|null\.$#'
			identifier: return.type
			count: 1
			path: Api.php

		-
			message: '#^Method Omnibus\\MondialRelay\\Api\:\:secrets\(\) should return list\<string\> but returns non\-empty\-array\<int\<0, max\>\|string, string\>\.$#'
			identifier: return.type
			count: 1
			path: Api.php

		-
			message: '#^Parameter \#1 \$string of function substr expects string, string\|null given\.$#'
			identifier: argument.type
			count: 1
			path: Api.php

		-
			message: '#^Argument of an invalid type mixed supplied for foreach, only iterables are supported\.$#'
			identifier: foreach.nonIterable
			count: 1
			path: Tests/MondialRelayGatewayTest.php

		-
			message: '#^Cannot access property \$at on Omnibus\\Model\\TrackingEvent\|null\.$#'
			identifier: property.nonObject
			count: 2
			path: Tests/MondialRelayGatewayTest.php

		-
			message: '#^Cannot call method children\(\) on mixed\.$#'
			identifier: method.nonObject
			count: 1
			path: Tests/MondialRelayGatewayTest.php
